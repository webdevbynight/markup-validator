{
  "name": "markup-validator",
  "version": "0.2.1",
  "description": "Check the markup validity of HTML, CSS and SVG files using the W3C validator",
  "keywords": [
    "css",
    "css3",
    "html",
    "html5",
    "markup",
    "svg",
    "validator",
    "w3c"
  ],
  "homepage": "https://github.com/webdevbynight/markup-validator",
  "bugs": {
    "url": "https://github.com/webdevbynight/markup-validator/issues"
  },
  "author": "Victor Brito (https://victor-brito.dev)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/webdevbynight/markup-validator.git"
  },
  "type": "module",
  "license": "MIT",
  "files": [
    "dist"
  ],
  "exports": {
    "import": "./dist/index.js",
    "types": "./dist/index.d.ts"
  },
  "bin": {
    "markup-validator": "./bin/cli.js"
  },
  "engines": {
    "node": "^22.12.0 || ^24.0.0",
    "npm": ">=10.9.0",
    "pnpm": ">=11.1.3"
  },
  "scripts": {
    "biome": "biome check --write .",
    "biome:check": "biome check .",
    "biome:format": "biome format --write .",
    "biome:format:check": "biome format .",
    "biome:lint": "biome lint --write .",
    "biome:lint:check": "biome lint .",
    "build": "tsc",
    "dev": "pnpm tsc:watch & pnpm test:watch",
    "prepare": "husky",
    "test": "vitest run",
    "test:watch": "vitest",
    "tsc:watch": "tsc --watch --preserveWatchOutput"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.8",
    "@commitlint/cli": "21.2.1",
    "@commitlint/config-conventional": "21.2.0",
    "@types/node": "24.13.3",
    "husky": "9.1.7",
    "typescript": "7.0.2",
    "vitest": "4.1.10"
  }
}
